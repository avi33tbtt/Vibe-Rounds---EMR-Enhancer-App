{
  "name": "emr-enhancer",
  "version": "0.1.0",
  "private": true,
  "description": "EMR Enhancer server (synthetic data only, not for clinical use)",
  "main": "server.js",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node --env-file=.env migrate.js",
    "seed": "node --env-file=.env seed.js",
    "demo:seed": "node --env-file=.env scripts/seed-demo.js",
    "demo:reset": "node --env-file=.env scripts/seed-demo.js --reset",
    "terms:seed": "node --env-file=.env scripts/seed-terms.js",
    "terms:reset": "node --env-file=.env scripts/seed-terms.js --reset",
    "demo:run": "node --env-file=.env scripts/demo-bridge.js",
    "start": "node --env-file=.env server.js",
    "test": "node --env-file=.env --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "express": "5.2.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright-core": "^1.65.1"
  }
}

# Copy this file to .env and edit. .env is git-ignored. Never commit real values.
# Every value below is a placeholder; replace all of them before any real use.
# Used by docker-compose.yml (local dev database only):
POSTGRES_PASSWORD=change-me-local-dev-only

# Required by server.js (it refuses to start without it).
# The user must be able to CREATE DATABASE (needed by the test run only).
DATABASE_URL=postgres://emr:change-me-local-dev-only@127.0.0.1:5432/emr

# The restricted role the running server uses (see 003_audit_grants.sql). DATABASE_URL above is then used for migrations only.
# One-time setup as a database admin:  ALTER ROLE emr_app LOGIN PASSWORD '<long random value>';
# Leave unset in local development (the server then uses DATABASE_URL and warns). Required in production.
# APP_DATABASE_URL=postgres://emr_app:<password>@127.0.0.1:5432/emr

# Optional
PORT=3000
NODE_ENV=development

# Used by login sessions from chunk 32 on. Placeholder: generate your own long random value,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

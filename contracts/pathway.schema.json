{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccis.invalid/schemas/pathway.schema.json",
  "title": "CCIS pathway",
  "description": "Workflow and information needed. No field can carry an action, order, treatment, dose or number (CCIS-REQ-025, 027).",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["manifest", "scope", "intendedUse", "exclusions", "elements", "stages"],
  "properties": {
    "manifest": {
      "allOf": [
        { "$ref": "https://ccis.invalid/schemas/manifest.schema.json" },
        { "type": "object", "properties": { "type": { "const": "pathway" } } }
      ]
    },
    "scope": { "$ref": "#/$defs/text" },
    "intendedUse": { "$ref": "#/$defs/text" },
    "exclusions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "elements": {
      "description": "Elements referenced by version range (CCIS-REQ-025).",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/reference" },
          { "type": "object", "properties": { "type": { "const": "contextual-element" } }, "required": ["range"] }
        ]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["id", "label", "kind", "entry", "exit"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" },
          "kind": { "enum": ["information", "report"] },
          "entry": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
          "exit": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
          "needs": { "type": "array", "items": { "$ref": "#/$defs/key" } }
        }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "https://ccis.invalid/schemas/decision-node.schema.json" } },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "via": { "$ref": "#/$defs/id" }
        }
      }
    },
    "timing": {
      "description": "Names what is related and the parameter id that will carry the number. Never a value.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["id", "between", "parameter"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "$ref": "#/$defs/text" },
          "between": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } }
          },
          "parameter": { "$ref": "#/$defs/key" }
        }
      }
    },
    "analytics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["ref", "requirement"],
        "properties": {
          "ref": {
            "allOf": [
              { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/reference" },
              { "type": "object", "properties": { "type": { "const": "analytics-package" } } }
            ]
          },
          "requirement": { "enum": ["required", "optional"] }
        }
      }
    },
    "entryForm": {
      "description": "Layout only: ordered sections of elements and section items (B5). No number, rule or threshold. Element membership, field existence and the known section list are checked by the validator (B6), not here.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["sections"],
      "properties": {
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/formSection" } }
      }
    },
    "contexts": {
      "description": "Which elements belong to a condition (B5). Never says what to do for the condition. Known tags are checked by the validator (B6).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/context" }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "^\\S.*$" },
    "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "formSection": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["id", "label", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/formItem" } }
      }
    },
    "formItem": {
      "oneOf": [
        {
          "description": "An element placed in the form, optionally with a field order and display-only row groups.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^x-": {} },
          "required": ["kind", "element"],
          "properties": {
            "kind": { "const": "element" },
            "element": { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/artefactId" },
            "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } },
            "rowGroups": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } } },
            "visibleByDefault": { "type": "boolean" }
          }
        },
        {
          "description": "A named section of the EMR form. Which names are known is checked by the validator (B6).",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^x-": {} },
          "required": ["kind", "section"],
          "properties": {
            "kind": { "const": "section" },
            "section": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
            "visibleByDefault": { "type": "boolean" }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["id", "label", "elements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/artefactId" } }
      }
    }
  }
}

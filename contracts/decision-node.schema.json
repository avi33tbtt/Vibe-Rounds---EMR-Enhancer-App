{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccis.invalid/schemas/decision-node.schema.json",
  "title": "CCIS decision node",
  "description": "A question about the record, with an outcome for every state including indeterminate, and a next step for each outcome (CCIS-REQ-026). Outcome tests are state tests only; value tests need the expression tree (row 1.3).",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["id", "question", "inputs", "outcomes"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "question": { "$ref": "#/$defs/text" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^x-": {} },
        "required": ["key", "element", "field"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "element": { "$ref": "https://ccis.invalid/schemas/manifest.schema.json#/$defs/artefactId" },
          "field": { "$ref": "#/$defs/key" }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "outcomes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/outcome" },
      "contains": { "type": "object", "properties": { "kind": { "const": "indeterminate" } }, "required": ["kind"] }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "^\\S.*$" },
    "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["id", "kind", "when", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["answer", "missing-data", "conflicting", "indeterminate"] },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "is"],
            "properties": {
              "input": { "$ref": "#/$defs/key" },
              "is": { "enum": ["present", "absent", "unknown", "not-collected", "not-applicable", "explicitly-negative", "entered-in-error", "conflicting"] }
            }
          }
        },
        "next": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["stage"], "properties": { "stage": { "$ref": "#/$defs/id" } } },
            { "type": "object", "additionalProperties": false, "required": ["end"], "properties": { "end": { "const": true } } }
          ]
        },
        "note": { "$ref": "#/$defs/text" }
      }
    }
  }
}
